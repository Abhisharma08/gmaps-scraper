# ---- Places API (only needed for the "api" source) ----
GOOGLE_MAPS_API_KEY=

# ---- Deployment settings (not needed for local use) ----
# Shared password for the web UI. Leave blank ONLY on localhost.
APP_PASSWORD=
# Signing key for session cookies. Generate with: openssl rand -hex 32
# Without it, everyone is logged out whenever the server restarts.
APP_SECRET=
# Set to true once the app is served over HTTPS.
COOKIE_SECURE=false
# How many scrape jobs may run at once (each browser job needs ~1GB RAM).
MAX_CONCURRENT_JOBS=2
# Default backend shown in the UI: browser | api
DEFAULT_SOURCE=browser
